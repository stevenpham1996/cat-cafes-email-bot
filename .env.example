# Supabase Configuration
# Retrieve these from your Supabase project settings > API
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_or_service_role_key_here

# SMTP Configuration for Email Sending
# The address of your email provider's SMTP server (e.g., smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=smtp.example.com

# The port for secure email submission.
# 587 is the standard for STARTTLS (recommended and used by this bot).
# 465 is for implicit SSL. 25 is often blocked by ISPs.
SMTP_PORT=587

# Your SMTP username (often your full email address)
SMTP_USER=your_username_or_email

# Your SMTP password or App Password (if 2FA is enabled on your provider)
# Or API Secret Key
SMTP_PASSWORD=your_secure_password

# The email address that will appear in the "From" field of sent emails
SENDER_EMAIL=connect@hotyogafinder.com

# Rate Limiting
# The number of emails to send per minute to avoid spam filters and API limits.
# Default: 30
RATE_LIMIT=30

# Website Configuration
# The base domain used to construct listing URLs
# Default: https://hotyogafinder.com
WEBSITE_DOMAIN=https://hotyogafinder.com